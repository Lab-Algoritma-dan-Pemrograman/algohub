{
  "name": "algohub",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "prettier": "@algohub/config/prettier",
  "scripts": {
    "dev:api": "cd backend && go run ./cmd/server",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "check": "tsc -p tsconfig.json && bun run --filter \"./apps/*\" --filter \"./packages/*\" --if-present check",
    "test": "bun run --filter \"./apps/*\" --filter \"./packages/*\" --if-present test",
    "build": "bun run --filter \"./apps/*\" --filter \"./packages/*\" --if-present build"
  },
  "devDependencies": {
    "@algohub/config": "workspace:*",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "~6.0.3"
  }
}
