# Daftar nama env per project Vercel. Nilai TIDAK ditulis di sini.
# Nilai rahasia ada di env Vercel dan E:\rekapProject\project_ap\_secrets\.

# ── algohub-api (backend/) ──────────────────────────────────────────
# development | production
APP_ENV=
# Origin eksak, dipisah koma. Wajib di production.
CORS_ORIGINS=
# Regex origin preview Vercel, dipisah koma (jangan pakai koma di dalam regex).
# Otomatis dibungkus ^(?:...)$.
CORS_ORIGIN_PATTERNS=
CRON_SECRET=

# Database (pooler Supabase port 6543). DSN sama dipakai bersama satu pool.
# Wajib. Sertakan parameter yang dulu ada di DB_PARAMS (mis. sslmode, TimeZone=Asia/Jakarta).
DATABASE_URL_PRAKTIKUM=
# Wajib sejak Fase 5. DATABASE_URL_ELEARNING = project elearning + praktikum.
DATABASE_URL_SIAKAD=
DATABASE_URL_ELEARNING=

# Praktikum: auth
JWT_SECRET=
JWT_EXPIRE_HOURS=
# legacy | dual | supabase
AUTH_MODE=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUD=
ALLOW_ITPLN_DOMAIN=
FB_SCRYPT_SIGNER_KEY=
FB_SCRYPT_SALT_SEPARATOR=
FB_SCRYPT_ROUNDS=
FB_SCRYPT_MEM_COST=

# Praktikum: storage, runner, AI
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=
SUPABASE_BUCKET_LAPORAN=
GLOT_URL=
GLOT_TOKEN=
OLLAMA_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=
ONLINE_TTL_SECONDS=

# ── apps (praktikum, siakad, elearning, portal) ───────────────────────
# URL API Go. Default dev: http://localhost:8080
PUBLIC_API_BASE_URL=
# Buster cache persist. Default: VERCEL_GIT_COMMIT_SHA, lalu 'dev'.
PUBLIC_APP_VERSION=
# URL dasar file compiler C (clang, lld, memfs, sysroot.tar), diakhiri versi, mis. /compiler/v1/
PUBLIC_COMPILER_BASE_URL=

# Siakad (wajib: DATABASE_URL_SIAKAD, DATABASE_URL_ELEARNING, SIAKAD_JWT_SECRET)
# Nilai sama dengan JWT_SECRET project siakad lama.
SIAKAD_JWT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WA_GATEWAY_TOKEN=
GEMINI_API_KEY=
BYNARA_API_KEY=

# Elearning. JWT_SECRET dan SIAKAD_JWT_SECRET di atas juga dipakai untuk verifikasi token.
ELEARNING_SUPABASE_URL=
ELEARNING_SUPABASE_ANON_KEY=
ELEARNING_SUPABASE_SERVICE_ROLE_KEY=
# Juga kunci HKDF untuk code SSO. Tanpa nilai ini /sso selalu ?error=server_error.
ELEARNING_SUPABASE_JWT_SECRET=
# API native Ollama (beda dengan OLLAMA_* praktikum yang memakai protokol OpenAI).
ELEARNING_OLLAMA_URL=
ELEARNING_OLLAMA_MODEL=
ELEARNING_OLLAMA_API_KEY=
ELEARNING_APP_URL=
